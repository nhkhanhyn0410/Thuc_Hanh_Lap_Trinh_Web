@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<style type="text/css">
    td {
        height: 40px;
    }
</style>

<h4 style="color:red; text-align:center;">@ViewBag.ThongBao</h4>
<h2 style="text-align:center;">ĐĂNG NHẬP</h2>

<table align="center">
    @using (Html.BeginForm("DangNhap", "User", FormMethod.Post))
    {
        @Html.ValidationSummary(true)

        <!-- Hidden field để lưu URL return -->
        <input type="hidden" name="url" value="@ViewBag.UrlReturn" />

        <tr>
            <td>Tên đăng nhập: </td>
            <td>
                @Html.TextBox("TenDN")
                @ViewData["Err1"]
            </td>
        </tr>
        <tr>
            <td>Mật khẩu: </td>
            <td>
                @Html.Password("MatKhau")
                @ViewData["Err2"]
            </td>
        </tr>
        <tr>
            <td></td>
            <td>
                <input type="submit" value="Đăng nhập" class="btn btn-primary" />
            </td>
        </tr>
    }
</table>