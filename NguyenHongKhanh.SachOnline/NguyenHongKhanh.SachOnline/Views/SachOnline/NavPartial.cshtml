@model IEnumerable<NguyenHongKhanh.SachOnline.Models.MENU>

    <ul class="nav navbar-nav">
        @{
        int i = 0;
        foreach (var item in Model)
        {
        if (ViewBag.lst[i] != 0)
        {
        <li class="dropdown">
            <a href="#" class="dropdown-toggle"
               data-toggle="dropdown"
               role="button"
               aria-expanded="false"
               aria-haspopup="true">
                @item.MenuName<span class="caret"></span>
            </a>
            @Html.Action("LoadChildMenu", "SachOnline", new { parentId = item.Id })
        </li>
        }
        else
        {
        if (!string.IsNullOrEmpty(@item.MenuLink))
        {
            if (@item.MenuLink.Contains("://"))
            {
            <li><a href="@item.MenuLink">@item.MenuName</a></li>
            }
            else
            {
            <li><a href="~/@item.MenuLink">@item.MenuName</a></li>
            }
        }
        else
        {
            <li><a href="#">@item.MenuName</a></li>
        }
        }
        i++;
        }
        }
    </ul>

    <style>
        .dropdown-submenu {
            position: relative;
        }

            .dropdown-submenu .dropdown-menu {
                top: 0;
                left: 100%;
                margin-top: -1px;
            }
    </style>

    <script>
        $(document).ready(function () {
            $('.dropdown-submenu a.test').on("click", function (e) {
                $(this).next('ul').toggle();
                e.stopPropagation(); /*Phương thức stopPropagation() của đối tượng event được sử dụng để ngăn không cho sự kiện lan tỏa lên các phần tử cha của phần tử đã xảy ra sự kiện.*/
                e.preventDefault(); /*Phương thức preventDefault() của đối tượng event được sử dụng để ngăn chặn xử lý mặc định của trình duyệt khi xảy ra sự kiện.*/
            });
        });
    </script>
