@model NguyenHongKhanh.SachOnline.Models.SACH
@{
    ViewBag.Title = "Chi tiết sách";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<div class="thumbnail">
    <h4 class="tensach">@Model.TenSach</h4>
    <img src="~/Images/@Model.AnhBia" alt="@Model.TenSach">
    <div class="motasach">
        <p>@Html.Raw(@Model.MoTa.ToString().Replace("\n", "<br>"))</p>
    </div>

    <p class="ngaycapnhat">Ngày cập nhật: @Html.FormatValue(@Model.NgayCapNhat, "{0:dd/MM/yyyy}")</p>
    <p class="giaban">Giá bán: @Html.FormatValue(@Model.GiaBan, "{0:#,##0}") VNĐ</p>

    <p>
        <a href="@Url.Action("ThemGioHang","GioHang", new { ms = Model.MaSach, url = Request.Url.ToString() })"
           class="btn btn-primary" role="button">
            <span class="glyphicon glyphicon-shopping-cart"></span> Add to Cart
        </a>
    </p>
</div>