@model NguyenHongKhanh.SachOnline.Models.CHUDE

@{
    ViewBag.Title = "Chỉnh sửa chủ đề";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<h2 style="text-align:center;">CHỈNH SỬA CHỦ ĐỀ</h2>

@using (Html.BeginForm("Edit", "ChuDe", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.MaCD)

        <div class="form-group">
            <label class="control-label col-md-2">Mã chủ đề</label>
            <div class="col-md-10">
                <p class="form-control-static">@Model.MaCD</p>
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Tên chủ đề</label>
            <div class="col-md-10">
                @Html.TextBoxFor(model => model.TenChuDe, new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(model => model.TenChuDe, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Cập nhật" class="btn btn-primary" />
                @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-default" })
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
