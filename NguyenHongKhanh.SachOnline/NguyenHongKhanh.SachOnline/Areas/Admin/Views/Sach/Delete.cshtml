@model NguyenHongKhanh.SachOnline.Models.SACH

@{
    ViewBag.Title = "Xóa sách";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<h2 style="text-align:center;">XÓA SÁCH</h2>

@if (ViewBag.ThongBao != null)
{
    <div class="alert alert-danger">
        @Html.Raw(ViewBag.ThongBao)
    </div>
}

<div class="alert alert-warning">
    <strong>Cảnh báo!</strong> Bạn có chắc chắn muốn xóa sách này không?
</div>

<div class="panel panel-danger">
    <div class="panel-heading">
        <h3 class="panel-title">Thông tin sách sẽ bị xóa</h3>
    </div>
    <div class="panel-body">
        <div class="row">
            <div class="col-md-4">
                @if (!string.IsNullOrEmpty(Model.AnhBia))
                {
                    <img src="~/Images/@Model.AnhBia" alt="@Model.TenSach" class="img-responsive img-thumbnail" />
                }
            </div>
            <div class="col-md-8">
                <dl class="dl-horizontal">
                    <dt>Mã sách:</dt>
                    <dd>@Model.MaSach</dd>

                    <dt>Tên sách:</dt>
                    <dd>@Model.TenSach</dd>

                    <dt>Mô tả:</dt>
                    <dd>@Html.Raw(Model.MoTa)</dd>

                    <dt>Ngày cập nhật:</dt>
                    <dd>@Html.FormatValue(Model.NgayCapNhat, "{0:dd/MM/yyyy}")</dd>

                    <dt>Số lượng bán:</dt>
                    <dd>@Model.SoLuongBan</dd>

                    <dt>Giá bán:</dt>
                    <dd>@Html.FormatValue(Model.GiaBan, "{0:#,##0}") VNĐ</dd>

                    <dt>Chủ đề:</dt>
                    <dd>@(Model.CHUDE != null ? Model.CHUDE.TenChuDe : "N/A")</dd>

                    <dt>Nhà xuất bản:</dt>
                    <dd>@(Model.NHAXUATBAN != null ? Model.NHAXUATBAN.TenNXB : "N/A")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="panel-footer">
        @using (Html.BeginForm("Delete", "Sach", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.MaSach" />
            <button type="submit" class="btn btn-danger">
                <i class="glyphicon glyphicon-trash"></i> Xác nhận xóa
            </button>
            @Html.ActionLink("Hủy bỏ", "Index", null, new { @class = "btn btn-default" })
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
