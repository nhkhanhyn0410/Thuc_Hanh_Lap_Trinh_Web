@model NguyenHongKhanh.SachOnline.Models.KHACHHANG

@{
    ViewBag.Title = "Chi tiết khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<h2 style="text-align:center;">CHI TIẾT THÔNG TIN KHÁCH HÀNG</h2>

<div class="panel panel-primary">
    <div class="panel-heading">
        <h3 class="panel-title">@Model.HoTen</h3>
    </div>
    <div class="panel-body">
        <dl class="dl-horizontal">
            <dt>Mã khách hàng:</dt>
            <dd>@Model.MaKH</dd>

            <dt>Họ tên:</dt>
            <dd>@Model.HoTen</dd>

            <dt>Tài khoản:</dt>
            <dd>@Model.TaiKhoan</dd>

            <dt>Email:</dt>
            <dd>@(String.IsNullOrEmpty(Model.Email) ? "Chưa cập nhật" : Model.Email)</dd>

            <dt>Địa chỉ:</dt>
            <dd>@(String.IsNullOrEmpty(Model.DiaChi) ? "Chưa cập nhật" : Model.DiaChi)</dd>

            <dt>Điện thoại:</dt>
            <dd>@(String.IsNullOrEmpty(Model.DienThoai) ? "Chưa cập nhật" : Model.DienThoai)</dd>

            <dt>Ngày sinh:</dt>
            <dd>@(Model.NgaySinh.HasValue ? Model.NgaySinh.Value.ToString("dd/MM/yyyy") : "Chưa cập nhật")</dd>

            <dt>Số đơn hàng:</dt>
            <dd>@(Model.DONDATHANGs != null ? Model.DONDATHANGs.Count() : 0) đơn</dd>
        </dl>
    </div>
    <div class="panel-footer">
        <a href="@Url.Action("Edit", new { id = Model.MaKH })" class="btn btn-warning">
            <i class="glyphicon glyphicon-pencil"></i> Chỉnh sửa
        </a>
        <a href="@Url.Action("Delete", new { id = Model.MaKH })" class="btn btn-danger">
            <i class="glyphicon glyphicon-trash"></i> Xóa
        </a>
        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
